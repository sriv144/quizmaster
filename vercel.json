{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @quizmaster/web build",
  "outputDirectory": "apps/web/build/client",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://quizmaster-api.onrender.com/api/:path*" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
